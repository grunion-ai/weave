{"nodes": [{"id": "src_handbook_guides_polymorphic_relations", "label": "Polymorphic relations (guide)", "file_type": "document", "source_file": "src/handbook/guides/polymorphic-relations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "src_handbook_guides_polymorphic_relations_classic_pair", "label": "Classic bidirectional relation pair (inverseFieldId)", "file_type": "concept", "source_file": "src/handbook/guides/polymorphic-relations.md", "source_location": "The classic pair", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A singleton target set collapses to the pair bit-for-bit, which makes the feature rollback-safe.", "_origin": "semantic"}, {"id": "src_handbook_guides_polymorphic_relations_target_set", "label": "Target set (targetDbs)", "file_type": "concept", "source_file": "src/handbook/guides/polymorphic-relations.md", "source_location": "The target set", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "src_handbook_guides_polymorphic_relations_surface_behaviour", "label": "Target set behaviour per surface (chip, picker, filter, map, dialog, link input)", "file_type": "concept", "source_file": "src/handbook/guides/polymorphic-relations.md", "source_location": "The target set", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "src_handbook_guides_polymorphic_relations_entity_ontology", "label": "Entity as the one core kind (every level is a record)", "file_type": "concept", "source_file": "src/handbook/guides/polymorphic-relations.md", "source_location": "Why a space can be a target", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Polymorphism falls out of the model: a space or table is a record in a regis