node_modules/
demo-workspace.json
uno.json
weave.json
weaver.json
*.db
*.db-wal
*.db-shm
files/
*.tmp
.DS_Store
.impeccable/
test.json

wrangler.toml
wrangler.jsonc
.dev.vars
.wrangler/

# Merge-tool debris and throwaway browser probes: an .orig is a byte copy of
# the file beside it (194KB of duplicated app.js the last one), and the probes
# are one-off Playwright scripts, not tests.
*.orig
.*-probe.mjs
.*-shot.mjs
.wt-slot/

# Playwright for the browser suites is a symlink to ~/.gerrit/weave/pw/node_modules, never committed
node_modules
update-check.json

# scripts/flicker-sweep.mjs default output
flicker-out/

# graphify: only the graph, its report, community names and the doc-pass cache are versioned (docs/graph.md)
graphify-out/*
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md
!graphify-out/.graphify_labels.json
!graphify-out/.graphify_labels.json.sig
!graphify-out/cache/
graphify-out/cache/*
!graphify-out/cache/semantic/

# scripts/cutoff-sweep.mjs and scripts/collision-sweep.mjs default output
cutoff-out/
collision-out/
