{
  "name": "weave",
  "version": "0.4.184",
  "description": "A portable work system you own, developed in the open. Connected records, documents and automations with native MCP, REST and CLI access for your existing agent. SQLite storage, zero runtime dependencies, no build step. MIT.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "weave": "bin/weave.js"
  },
  "main": "src/engine.js",
  "scripts": {
    "test": "node scripts/test.mjs",
    "start": "node bin/weave.js serve",
    "seed": "node scripts/seed.mjs",
    "ui-catalog": "node tools/ui-catalog/run.mjs"
  },
  "engines": {
    "node": ">=22.16"
  },
  "keywords": [
    "airtable-alternative",
    "fibery-alternative",
    "notion-alternative",
    "clickup-alternative",
    "self-hosted",
    "local-first",
    "open-source",
    "no-code",
    "low-code",
    "database",
    "sqlite",
    "work-management",
    "project-management",
    "knowledge-base",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agents",
    "rest-api",
    "markdown",
    "zero-dependency"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/grunion-ai/weave"
  }
}
