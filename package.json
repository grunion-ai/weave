{
  "name": "weave",
  "version": "0.2.0",
  "description": "Weave — a local, open-source, agent-accessible work platform (Fibery-style): tables, relations, workflows, lookups, rollups, formulas, per-entity documents (MD/HTML/PDF), REST API, web UI, CLI, and MCP server.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "weave": "bin/weave.js"
  },
  "main": "src/engine.js",
  "scripts": {
    "test": "node --test test/",
    "start": "node bin/weave.js serve",
    "seed": "node scripts/seed.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "fibery",
    "work-management",
    "database",
    "no-code",
    "mcp",
    "agent",
    "local-first",
    "markdown"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/grunion-ai/weave"
  }
}
