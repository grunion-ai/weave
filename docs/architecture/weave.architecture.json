  "cards": [
    {
      "dot": "cyan",
      "title": "One core, one host",
      "items": [
        "src/server.js wraps src/routes.js in node:http",
        "src/minify.js strips whitespace from first-party scripts and styles before src/server.js compresses them",
        "src/store.js keeps one node:sqlite .db per workspace",
        "src/server.js answers each workspace at <slug>.WEAVE_BASE_DOMAIN"
      ]
    },
    {
      "dot": "emerald",
      "title": "Shared modules",
      "items": [
        "src/vocabulary.js and src/field-hints.js: one field vocabulary, schema-write hints",
        "src/ids.js, src/mark.js, src/workspace-name.js: ids, mark, names",
        "src/applet.js, src/bugreport.js, src/legal.js, src/mail.js, src/mail-send.js: routes, legal pages, invite mail",
        "src/billing.js: paid seats read from Clerk Billing, Editors and Architects mirrored into a Clerk organization",
        "src/forms.js: Workspace/Forms rows, one-row submissions, the built-in weave docs workspace",
        "src/shares.js: share grants, the withinScope check and the /s/ pages"
      ]
    },
    {
      "dot": "amber",
      "title": "Weave records itself",
      "items": [
        "src/handbook.js writes the Handbook into the weave workspace",
        "src/weaver-seed.js and src/quality-mirror.js sync Development and Quality",
        "src/service.js, src/update-check.js and src/supervisor.js: launchd, newer releases, in-place swaps"
      ]
    }
  ]
