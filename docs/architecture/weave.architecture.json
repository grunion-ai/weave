  "cards": [
    {
      "dot": "cyan",
      "title": "One core, two hosts",
      "items": [
        "src/routes.js imports no node:http or node:fs",
        "src/server.js wraps it for node, src/worker.js for workerd",
        "src/store.js and src/store-cf.js share one Store interface"
      ]
    },
    {
      "dot": "emerald",
      "title": "Shared by every runtime",
      "items": [
        "src/vocabulary.js: one field vocabulary for UI, CLI and MCP",
        "src/field-hints.js: the next settings and hints a schema write answers with on MCP, REST and the CLI",
        "src/ids.js, src/mark.js and src/workspace-name.js: ids, the rope mark, a new workspace's name",
        "src/applet.js, src/bugreport.js, src/oidc.js, src/legal.js, src/mail.js and src/mail-send.js: routes, provider sign-in, the public privacy and terms pages, and the invite emails and their sender behind the request core"
      ]
    },
    {
      "dot": "amber",
      "title": "Weave records itself",
      "items": [
        "src/handbook.js writes the Handbook into the weave workspace",
        "src/weaver-seed.js and src/quality-mirror.js sync Development and Quality",
        "src/service.js, src/rehearse.js, src/update-check.js and src/supervisor.js: launchd, rehearsal, newer releases, in-place swaps"
      ]
    }
  ]
