          "role": "name"
        },
        {
          "name": "Description",
          "type": "document",
          "role": "description"
        },
        {
          "name": "Kind",
          "type": "select",
          "description": "Checking, Savings, Credit card or Cash.",
          "options": [
            "Checking",
            "Savings",
            "Credit card",
            "Cash"
          ],
          "optionsFull": [
            {
              "name": "Checking",
              "hue": "blue",
