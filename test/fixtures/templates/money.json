            },
            {
              "name": "Cash",
              "hue": "slate",
              "icon": "lucide:wallet",
              "color": ""
            }
          ]
        },
        {
          "name": "Institution",
          "type": "text",
          "description": "The bank or card issuer, as you would say it."
        },
        {
          "name": "Bills",
          "type": "relation",
          "description": "The Bills charged to this account.",
          "targetDb": "Money/Bills",
          "many": true,
          "inverseField": "Account"
        },
        {
          "name": "Transactions",
          "type": "relation",
          "description": "Spending that left this account, newest first.",
          "targetDb": "Money/Transactions",
          "many": true,
          "inverseField": "Account"
        },
        {
          "name": "Income",
          "type": "relation",
          "description": "Money that landed in this account.",
          "targetDb": "Money/Income",
          "many": true,
          "inverseField": "Account"
        },
        {
          "name": "Spent",
          "type": "rollup",
          "description": "Total of the Transactions that left this account. Computed; do not set.",
          "via": "Transactions",
          "targetField": "Amount",
          "aggregate": "sum",
          "format": "currency",
          "currency": "USD"
        },
        {
          "name": "Received",
          "type": "rollup",
          "description": "Total of the Income that landed in this account. Computed; do not set.",
          "via": "Income",
          "targetField": "Amount",
          "aggregate": "sum",
          "format": "currency",
          "currency": "USD"
        },
        {
          "name": "Chip",
          "type": "view",
          "role": "chip",
          "shape": "chip",
          "link": false,
          "state": true,
          "description": "none",
