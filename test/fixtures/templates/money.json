    {
      "name": "Months",
      "description": "One row per calendar month. Spent and Earned total the Transactions and Income filed under the month; Net is Earned minus Spent. Budget is the total you plan to spend that month, and Over budget shows by how much Spent passed it (zero or below means under budget).",
      "icon": "lucide:calendar",
      "hiddenFields": [
        "Description",
        "Transactions",
        "Income",
        "Chip",
        "Card"
      ],
      "sort": [
        {
          "field": "Month",
          "dir": "desc"
        }
      ],
