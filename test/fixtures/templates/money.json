        "@values",
        "Description",
        "Transactions",
        "Income"
      ],
      "term": {
        "singular": "month",
        "plural": "months",
        "set": true
      },
      "noun": "month",
      "qualified": "Money/Months",
      "fields": [
        {
          "name": "Name",
          "type": "text",
          "term": {
            "singular": "month",
            "plural": "months"
          },
          "role": "name"
        },
        {
          "name": "Description",
          "type": "document",
          "role": "description"
        },
        {
          "name": "Month",
          "type": "date",
          "description": "The calendar month this row covers.",
          "grain": [
            "year",
            "month"
          ]
        },
        {
          "name": "Budget",
          "type": "number",
          "description": "The total planned spending for the month, in USD. Usually the sum of the Categories' monthly budgets.",
          "format": "currency",
          "currency": "USD"
        },
        {
          "name": "Transactions",
          "type": "relation",
          "description": "Spending filed under this month.",
          "targetDb": "Money/Transactions",
          "many": true,
          "inverseField": "Month"
        },
        {
          "name": "Income",
          "type": "relation",
          "description": "Income filed under this month.",
          "targetDb": "Money/Income",
          "many": true,
          "inverseField": "Month"
        },
        {
          "name": "Spent",
          "type": "rollup",
          "description": "Total of the Transactions filed under this month. Computed; do not set.",
          "via": "Transactions",
          "targetField": "Amount",
          "aggregate": "sum",
          "format": "currency",
          "currency": "USD"
        },
        {
          "name": "Earned",
          "type": "rollup",
          "description": "Total of the Income filed under this month. Computed; do not set.",
          "via": "Income",
          "targetField": "Amount",
          "aggregate": "sum",
          "format": "currency",
          "currency": "USD"
        },
        {
          "name": "Net",
          "type": "formula",
          "description": "Earned minus Spent; negative means the month cost more than it brought in. Computed; do not set.",
          "format": "currency",
          "currency": "USD",
          "expression": "[Earned] - [Spent]"
        },
        {
          "name": "Over budget",
          "type": "formula",
          "description": "Spent minus Budget; above zero means over budget by that much. Computed; do not set.",
          "format": "currency",
          "currency": "USD",
          "expression": "[Spent] - [Budget]"
        },
        {
          "name": "Chip",
          "type": "view",
          "role": "chip",
          "shape": "chip",
          "link": false,
          "state": true,
          "description": "none",
          "fields": null
