      "fields": [
        {
          "name": "Name",
          "type": "text",
          "term": {
            "singular": "bill",
            "plural": "bills"
          },
          "role": "name"
        },
        {
          "name": "Description",
          "type": "document",
          "role": "description"
        },
        {
          "name": "Status",
          "type": "workflow",
          "description": "Active: charging as normal. Paused: on hold, not charging. Cancelled: ended; keep the row for history.",
          "states": [
            {
              "name": "Active",
              "category": "in-progress",
              "default": true,
              "icon": "lucide:play"
            },
            {
              "name": "Paused",
              "category": "not-started",
              "default": false,
              "icon": "lucide:clock"
            },
            {
              "name": "Cancelled",
              "category": "canceled",
              "default": false,
              "icon": "lucide:square-x"
            }
          ]
        },
        {
          "name": "Amount",
          "type": "number",
          "description": "What one charge costs, in USD, for the Period below.",
          "format": "currency",
          "currency": "USD"
        },
        {
          "name": "Period",
          "type": "select",
          "description": "How often the charge comes: Weekly, Monthly, Quarterly or Yearly.",
          "options": [
            "Weekly",
            "Monthly",
            "Quarterly",
            "Yearly"
          ],
          "optionsFull": [
            {
              "name": "Weekly",
              "hue": "slate",
              "icon": "",
              "color": ""
            },
            {
              "name": "Monthly",
              "hue": "slate",
              "icon": "",
              "color": ""
            },
            {
              "name": "Quarterly",
              "hue": "slate",
              "icon": "",
              "color": ""
            },
            {
              "name": "Yearly",
              "hue": "slate",
              "icon": "",
              "color": ""
            }
          ]
        },
        {
          "name": "Next due",
          "type": "date",
          "description": "The date of the next charge. Move it forward after each payment."
        },
        {
          "name": "Cancel by",
          "type": "date",
          "description": "The last day to cancel before a trial converts or a plan renews. Leave blank when you mean to keep it."
        },
        {
          "name": "Account",
          "type": "relation",
          "description": "The account the charge comes out of.",
          "targetDb": "Money/Accounts",
          "many": false,
          "inverseField": "Bills"
        },
        {
          "name": "Category",
          "type": "relation",
          "description": "The category the charge counts against.",
          "targetDb": "Money/Categories",
          "many": false,
          "inverseField": "Bills"
        },
        {
          "name": "Transactions",
          "type": "relation",
          "description": "The payments made against this bill, one per charge.",
          "targetDb": "Money/Transactions",
          "many": true,
          "inverseField": "Bill"
        },
        {
          "name": "Monthly cost",
          "type": "formula",
          "description": "Amount as a monthly figure: weekly times 52 over 12, quarterly over 3, yearly over 12. Computed; do not set.",
          "format": "currency",
          "currency": "USD",
          "expression": "round(if([Period] = \"Weekly\", [Amount] * 52 / 12, if([Period] = \"Quarterly\", [Amount] / 3, if([Period] = \"Yearly\", [Amount] / 12, [Amount]))), 2)"
        },
        {
          "name": "Days until due",
          "type": "formula",
          "description": "Days from today to Next due; negative means overdue. Computed; do not set.",
          "expression": "if(empty([Next due]), \"\", days(today(), [Next due]))"
        },
        {
          "name": "Chip",
          "type": "view",
          "role": "chip",
          "shape": "chip",
          "link": false,
          "state": true,
          "description": "none",
          "fields": null
